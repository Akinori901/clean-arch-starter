<Project Sdk="Microsoft.NET.Sdk">

  <!--
    最内層。**ProjectReference を一切持たない。**

    これが C# におけるクリーンアーキテクチャの最大の強みで、
    依存の向きがビルドシステムそのものによって強制される。
    ここに <ProjectReference> を 1 行足すと dotnet build がコンパイルエラーで落ちる。

    NuGet パッケージも入れないこと。EF Core / AWS SDK が入った時点で、
    それはもうドメインではない（NetArchTest が二重に検知する）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
