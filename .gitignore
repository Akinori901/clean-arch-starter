# 秘密情報は絶対にコミットしない。
# .env は .env.example のみ追跡する。
.env
.env.*
!.env.example

# 鍵・証明書の類は拡張子ごと弾く
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.ppk

# 依存
node_modules/
vendor/
venv/
.venv/
__pycache__/
*.py[cod]

# ビルド成果物
dist/
build/
*.egg-info/
# .NET（bin/ obj/ は各プロジェクト直下に作られる）
#
# **.NET 配下に限定すること。** 素の `[Bb]in/` にすると、
# Hanami の bin/verify-layers や Django の bin/verify-design のような
# **手で書いたスクリプトまで巻き込む**（実際に新規追加が弾かれた）。
services/dotnet-clean/**/[Bb]in/
services/dotnet-clean/**/[Oo]bj/

# ツールのキャッシュ
.ruff_cache/
.mypy_cache/
.pytest_cache/
.phpunit.result.cache
.phpstan.cache/

# IaC
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
tfplan
.aws-sam/

# OS / エディタ
.DS_Store
.idea/
*.swp

# cognito-local が実行時に作る状態ファイル（テストユーザー等）。
# make seed で環境ごとに作り直すため、リポジトリには含めない。
docker/cognito/db/
